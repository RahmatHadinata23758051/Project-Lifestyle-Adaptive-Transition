# Project Chronos Backend Environment Configuration
PROJECT_NAME="Project Chronos"
API_V1_STR="/api/v1"
ALLOWED_ORIGINS=["http://localhost", "http://localhost:3000", "http://localhost:8000", "http://10.0.2.2:8000"]

# Database URL (SQLite default for local, or PostgreSQL connection string)
DATABASE_URL="sqlite:///./chronos.db"

# Supabase Auth & PostgreSQL Credentials (NEVER commit actual secrets to git)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"
